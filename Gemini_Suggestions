This optimized layout engine ports performance capabilities directly from [oits-webiz-gemdem](https://github.com/FarhanSabit-OITS/oits-webiz-gemdem). It dynamically queries network signals before inserting asset links, matching visual reorganizations under fluid Framer Motion containers.

```tsx
import React, { useState, useMemo } from "react";
import { motion, AnimatePresence } from "motion/react";
import { UNIFIED_PORTFOLIO } from "../constants";
import { Eye, HardDrive } from "lucide-react";

// Extend local navigator interface type layers securely
interface NetworkInformation extends EventTarget {
  readonly saveData: boolean;
  readonly effectiveType: "2g" | "3g" | "4g";
}

export default function PortfolioGrid() {
  const [activeFilter, setActiveFilter] = useState("ALL");
  const items = useMemo(() => UNIFIED_PORTFOLIO, []);

  // Performance Guardrail: Connection Speed Profiler
  const handlePrefetchAsset = (webmPath: string) => {
    const nav = navigator as Navigator & { connection?: NetworkInformation };
    if (nav.connection) {
      if (
        nav.connection.saveData ||
        ["2g", "3g"].includes(nav.connection.effectiveType)
      ) {
        return; // Suppress pre-downloads to save mobile billing thresholds
      }
    }

    // Dynamic Header Prefetch Insertion
    if (!document.querySelector(`link[href="${webmPath}"]`)) {
      const link = document.createElement("link");
      link.rel = "prefetch";
      link.as = "video";
      link.href = webmPath;
      document.head.appendChild(link);
    }
  };

  const categories = useMemo(() => {
    return ["ALL", ...new Set(items.map((item) => item.category))];
  }, [items]);

  const filteredItems = useMemo(() => {
    if (activeFilter === "ALL") return items;
    return items.filter((item) => item.category === activeFilter);
  }, [items, activeFilter]);

  return (
    <div className="max-w-7xl mx-auto px-6 md:px-12 py-16 space-y-12">
      {/* Precision Structural Navigation Tabs */}
      <div className="flex flex-wrap gap-2 border-b border-swiss-white/10 pb-6">
        {categories.map((cat) => (
          <button
            key={cat}
            onClick={() => setActiveFilter(cat)}
            className={`font-mono text-[10px] tracking-widest uppercase px-4 py-2 border transition-all duration-300 ${
              activeFilter === cat
                ? "border-swiss-accent text-swiss-accent bg-swiss-accent/5"
                : "border-swiss-white/10 text-swiss-muted hover:border-swiss-white/30 hover:text-white"
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      {/* Kinetic Grid Layer with popLayout constraints to neutralize layout shifts */}
      <motion.div
        layout
        className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      >
        <AnimatePresence mode="popLayout">
          {filteredItems.map((project) => (
            <motion.article
              layout
              key={project.id}
              initial={{ opacity: 0, scale: 0.98 }}
              animate={{ opacity: 1, scale: 1 }}
              exit={{ opacity: 0, scale: 0.98 }}
              transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }}
              onMouseEnter={() => handlePrefetchAsset(project.media.webm)}
              className="border border-swiss-white/10 bg-swiss-black group relative flex flex-col justify-between h-96 p-6 overflow-hidden transition-all duration-500 hover:border-swiss-accent/30 hover:shadow-premium-glow"
            >
              <div className="space-y-4">
                <div className="flex justify-between items-center font-mono text-[9px] tracking-widest text-swiss-muted">
                  <span>{project.category}</span>
                  <span className="flex items-center gap-1 text-swiss-accent">
                    <HardDrive className="w-2.5 h-2.5" /> {project.status}
                  </span>
                </div>
                <h3 className="text-xl font-bold tracking-tight uppercase text-white">
                  {project.title}
                </h3>
                <p className="text-swiss-muted text-xs tracking-tight line-clamp-3">
                  {project.description}
                </p>
              </div>

              {/* Dynamic Video Canvas Layer */}
              <div className="absolute inset-0 z-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 bg-swiss-black">
                <video
                  src={project.media.webm}
                  poster={project.media.poster}
                  loop
                  muted
                  playsInline
                  autoPlay
                  className="w-full h-full object-cover mix-blend-luminosity brightness-75"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-swiss-black via-swiss-black/40 to-transparent" />
              </div>

              {/* Footnotes Display Wrapper */}
              <div className="relative z-10 pt-4 border-t border-swiss-white/5 flex justify-between items-center bg-swiss-black/40 backdrop-blur-sm">
                <div className="flex flex-wrap gap-1.5 max-w-[70%]">
                  {project.tags.slice(0, 3).map((tag, idx) => (
                    <span
                      key={idx}
                      className="font-mono text-[9px] bg-swiss-white/5 px-2 py-0.5 text-swiss-white/80"
                    >
                      {tag}
                    </span>
                  ))}
                </div>
                <button className="font-mono text-[10px] tracking-widest uppercase text-white flex items-center gap-1.5 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                  <Eye className="w-3.5 h-3.5 text-swiss-accent" /> VIEW_SYSTEM
                </button>
              </div>
            </motion.article>
          ))}
        </AnimatePresence>
      </motion.div>
    </div>
  );
}
```

